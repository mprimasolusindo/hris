        <mxCell id="ds8" value="&lt;b&gt;D8: Talent &amp; Performance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ccfbf1&quot; style=&quot;font-size: 11px;&quot;&gt;perf_reviews, nine_box_assessments, talent_pools, succession_plans, trainings&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#0f766e;strokeColor=#115e59;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="880" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ds9" value="&lt;b&gt;D9: Outsourcing &amp; Billing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ccfbf1&quot; style=&quot;font-size: 11px;&quot;&gt;rel_vendor_employees, outsourcing_compliance_records, bill_vendor_invoices&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#0f766e;strokeColor=#115e59;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="990" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- Process-DataStore Connections -->
        <mxCell id="p_ds_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p1" target="ds1" />
        <mxCell id="p_ds_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p2" target="ds2" />
        <mxCell id="p_ds_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p3" target="ds3" />
        <mxCell id="p_ds_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p4" target="ds4" />
        <mxCell id="p_ds_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p5" target="ds5" />
        <mxCell id="p_ds_6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p6" target="ds6" />
        <mxCell id="p_ds_7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p7" target="ds7" />
        <mxCell id="p_ds_8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p8" target="ds8" />
        <mxCell id="p_ds_9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="p9" target="ds9" />

        <!-- Cross-subsystem Payroll data feeder lines -->
        <mxCell id="feed_emp" value="Base Salary, Fixed Allowances, Deductions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.2;exitY=1;entryX=0.8;entryY=0;strokeColor=#d97706;strokeWidth=1.5;fontSize=10;fontColor=#b45309;" edge="1" parent="1" source="ds3" target="p6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1168" y="620" />
              <mxPoint x="776" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="feed_att" value="Payable days &amp; Overtime Hours" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.3;exitY=1;entryX=0.6;entryY=0;strokeColor=#d97706;strokeWidth=1.5;fontSize=10;fontColor=#b45309;" edge="1" parent="1" source="ds4" target="p6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1202" y="635" />
              <mxPoint x="712" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Recruitment to Employee Master (Hiring pipeline) -->
        <mxCell id="hire_pipe" value="Hired Candidate Provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="p7" target="p3" />
      </root>
    </mxGraphModel>
  </diagram>

  <!-- Page 3: Level 2 Indonesian Payroll & Tax Engine -->
  <diagram id="page-l2-payroll" name="Level 2 - Indonesian Payroll Flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pay_title" value="DFD 2.1 — Indonesian Payroll &amp; Statutory Calculation Engine (PMK 168/2023 TER &amp; BPJS)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="350" y="25" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Triggers / Inputs -->
        <mxCell id="step1_box" value="&lt;b&gt;1. Employee Data Aggregation&lt;/b&gt;&lt;br&gt;• Base Salary from &lt;i&gt;emp_contracts&lt;/i&gt;&lt;br&gt;• PTKP Status (TK/0 - K/3) &amp; NPWP from &lt;i&gt;emp_tax_profiles&lt;/i&gt;&lt;br&gt;• Allowances (Fixed/Variable) from &lt;i&gt;emp_allowances&lt;/i&gt;&lt;br&gt;• Deductions &amp; Active Loans from &lt;i&gt;emp_deductions / loans&lt;/i&gt;&lt;br&gt;• Overtime Hours &amp; Unpaid Leaves from &lt;i&gt;ot_overtimes / lv_leaves&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="380" height="150" as="geometry" />
        </mxCell>

        <!-- Gross Calculation -->
        <mxCell id="step2_box" value="&lt;b&gt;2. Gross Taxable Income Calculation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Gross Pay&lt;/b&gt; = Base Salary + Fixed Allowances + Variable Allowances + Overtime Pay + Taxable Benefits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;strokeWidth=2;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- BPJS Calculation Block -->
        <mxCell id="step3_bpjs" value="&lt;b&gt;3. BPJS 6-Program Statutory Engine (cfg_bpjs)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;width:100%; font-size:11px; color:#ffffff;&quot;&gt;&lt;tr&gt;&lt;td&gt;• BPJS Kesehatan:&lt;/td&gt;&lt;td&gt;4% Employer, 1% Employee (Max Cap Rp 12M)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• BPJS TK JHT:&lt;/td&gt;&lt;td&gt;3.7% Employer, 2% Employee&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• BPJS TK JP:&lt;/td&gt;&lt;td&gt;2% Employer, 1% Employee (Annual Cap indexed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• BPJS TK JKK:&lt;/td&gt;&lt;td&gt;0.24% - 1.74% Employer (Risk Group based)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• BPJS TK JKM:&lt;/td&gt;&lt;td&gt;0.3% Employer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• BPJS TK JKP:&lt;/td&gt;&lt;td&gt;Government Funded (UU Cipta Kerja)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#075985;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="460" height="170" as="geometry" />
        </mxCell>

        <!-- PPh 21 TER Engine -->
        <mxCell id="step4_tax" value="&lt;b&gt;4. PPh 21 TER Calculation Engine (PMK 168/2023)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Determine Category&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• &lt;b&gt;TER A&lt;/b&gt;: TK/0, TK/1, K/0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• &lt;b&gt;TER B&lt;/b&gt;: TK/2, TK/3, K/1, K/2&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• &lt;b&gt;TER C&lt;/b&gt;: K/3&lt;br&gt;2. &lt;b&gt;Bracket Lookup&lt;/b&gt; in &lt;i&gt;cfg_tax_rules&lt;/i&gt; using Gross Taxable Base (Gross + Employer BPJS Kes/JKK/JKM)&lt;br&gt;3. &lt;b&gt;Tax Withholding&lt;/b&gt; = Gross Base × Effective Monthly Rate (%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#9a3412;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="460" height="180" as="geometry" />
        </mxCell>

        <!-- Take-Home Pay Result -->
        <mxCell id="step5_net" value="&lt;b&gt;5. Net Take-Home Pay (THP) Calculation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px; color:#a7f3d0;&quot;&gt;THP = Gross Salary - (Employee BPJS 4% + PPh 21 TER + Loans + Deductions)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#047857;strokeWidth=2;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="380" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Data Storage & Payslips -->
        <mxCell id="step6_store" value="&lt;b&gt;6. Finalization &amp; Storage&lt;/b&gt;&lt;br&gt;• Insert Batch to &lt;i&gt;pay_payrolls&lt;/i&gt;&lt;br&gt;• Insert Itemized Lines to &lt;i&gt;pay_payroll_items&lt;/i&gt;&lt;br&gt;• Generate Digital PDF Payslips&lt;br&gt;• Export Bank Transfer File (BCA/Mandiri/BRI format)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#0f766e;strokeColor=#115e59;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="720" y="600" width="440" height="150" as="geometry" />
        </mxCell>

        <!-- Flow Connectors -->
        <mxCell id="pflow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="1" source="step1_box" target="step2_box" />
        <mxCell id="pflow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="1" source="step2_box" target="step3_bpjs" />
        <mxCell id="pflow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="1" source="step2_box" target="step4_tax" />
        <mxCell id="pflow4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="1" source="step4_tax" target="step5_net" />
        <mxCell id="pflow5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#047857;strokeWidth=2;" edge="1" parent="1" source="step3_bpjs" target="step5_net" />
        <mxCell id="pflow6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="step5_net" target="step6_store" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
